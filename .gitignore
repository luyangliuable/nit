# A global gitignore ignores uppercase markdown; keep our README tracked
!README.md

node_modules
**/node_modules
.next
out
data
*.log
.DS_Store
.env
.env.local
next-env.d.ts
*.tsbuildinfo

# npm registry config may contain private tokens; never commit it
.npmrc
**/.npmrc

# Docusaurus build artefacts
website/build
website/.docusaurus

# Common language build artefacts
.venv
__pycache__
*.pyc
dist
build
target

# electron-builder resources live in build/ and must stay tracked
!build/
!build/**

# Electron packaging output
release

# Lockfiles pin an internal registry; resolve fresh from the public npm
package-lock.json
**/package-lock.json
